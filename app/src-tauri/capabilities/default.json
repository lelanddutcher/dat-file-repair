{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window's web page is allowed to call.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/lelanddutcher/dat-file-repair/issues*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**/*.mp4" }, { "path": "**/*.MP4" }]
    }
  ]
}
